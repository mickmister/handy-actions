{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "12.5.1",
      "node": "22.23.2",
      "autoIncrement": true,
      "env": {
        "EXPO_USE_FAST_RESOLVER": "true"
      }
    },
    "validation": {
      "extends": "preview",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "env": {
          "GYM_XCARGS": "ARCHS=arm64 ONLY_ACTIVE_ARCH=YES"
        }
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true,
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a --max-workers=2"
      }
    },
    "development": {
      "extends": "base",
      "channel": "development",
      "distribution": "internal",
      "developmentClient": true,
      "env": {
        "EXPO_APP_PROFILE": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m1-medium"
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "distribution": "internal",
      "developmentClient": false,
      "env": {
        "EXPO_APP_PROFILE": "preview"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m1-medium"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "distribution": "store",
      "developmentClient": false,
      "env": {
        "EXPO_APP_PROFILE": "production"
      }
    }
  }
}
