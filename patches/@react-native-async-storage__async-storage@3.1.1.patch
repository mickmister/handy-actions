--- /dev/null
+++ b/apple/legacy_storage/HandyPersistentSettings.h
@@ -0,0 +1,15 @@
+#import <Foundation/Foundation.h>
+
+typedef NSString *_Nullable (^HandyLegacyFileReader)(NSString *path, NSString *key,
+                                                     NSDictionary *_Nullable *_Nullable errorOut);
+
+// Attempt the read directly: fileExistsAtPath can report false when a protected
+// file is inaccessible. Only an actual no-such-file error means missing data.
+FOUNDATION_EXPORT NSString *_Nullable HandyReadPersistentFile(
+    NSString *path, NSError *_Nullable *_Nullable errorOut);
+
+// Foundation-only so the actual production read path can be regression-tested
+// without React. Recovery is scoped to settings, never delivery/receipt records.
+FOUNDATION_EXPORT NSString *_Nullable HandyReadLegacyValue(
+    NSString *key, NSMutableDictionary *manifest, NSCache *cache, NSString *filePath,
+    NSDictionary *_Nullable *_Nullable errorOut, HandyLegacyFileReader readFile);
diff --git a/apple/legacy_storage/HandyPersistentSettings.m b/apple/legacy_storage/HandyPersistentSettings.m
new file mode 100644
index 0000000000000000000000000000000000000000..e144a8d0165518f203e4e8b2cfda0cf24285f6df
--- /dev/null
+++ b/apple/legacy_storage/HandyPersistentSettings.m
@@ -0,0 +1,52 @@
+#import "HandyPersistentSettings.h"
+
+NSString *HandyReadPersistentFile(NSString *path, NSError **errorOut) {
+  if (errorOut) *errorOut = nil;
+  NSError *error = nil;
+  NSStringEncoding encoding = NSUTF8StringEncoding;
+  NSString *value = [NSString stringWithContentsOfFile:path usedEncoding:&encoding error:&error];
+  if (!value) {
+    BOOL missing = [error.domain isEqualToString:NSCocoaErrorDomain] &&
+      (error.code == NSFileReadNoSuchFileError || error.code == NSFileNoSuchFileError);
+    if (!missing && errorOut) *errorOut = error ?: [NSError errorWithDomain:NSCocoaErrorDomain code:NSFileReadUnknownError userInfo:nil];
+    return nil;
+  }
+  if (encoding != NSUTF8StringEncoding) {
+    if (errorOut) *errorOut = [NSError errorWithDomain:NSCocoaErrorDomain code:NSFileReadInapplicableStringEncodingError userInfo:nil];
+    return nil;
+  }
+  return value;
+}
+
+NSString *HandyReadLegacyValue(NSString *key, NSMutableDictionary *manifest,
+                             NSCache *cache, NSString *filePath,
+                             NSDictionary **errorOut, HandyLegacyFileReader readFile) {
+  id entry = manifest[key];
+  if ([entry isKindOfClass:NSString.class]) return entry;
+  BOOL recoverSettings = [key isEqualToString:@"handy-actions/state/v1"] ||
+                        [key isEqualToString:@"handy-actions/state-recovery/v1"];
+  if (!entry && !recoverSettings) return nil;
+  if (entry && entry != NSNull.null) {
+    if (errorOut) *errorOut = @{@"message": @"Invalid stored value metadata.", @"key": key};
+    return nil;
+  }
+  // Do not trust a cache-only value when the manifest lacks this key. Recovery
+  // must find the original file, rather than reviving a stale cached value.
+  NSString *value = entry ? [cache objectForKey:key] : nil;
+  if (value) return value;
+  NSDictionary *readError = nil;
+  value = readFile(filePath, key, &readError);
+  if (readError) {
+    // A protected/unreadable file is NOT missing. Removing this mapping would
+    // let an unrelated automatic write persist the omission after a cold start.
+    if (errorOut) *errorOut = readError;
+    return nil;
+  }
+  if (value) {
+    manifest[key] = NSNull.null;
+    [cache setObject:value forKey:key cost:value.length];
+  } else if (entry) {
+    [manifest removeObjectForKey:key]; // Confirmed absent, with no read error.
+  }
+  return value;
+}
