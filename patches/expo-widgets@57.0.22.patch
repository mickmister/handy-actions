+  private static func directory() throws -> URL {
+    let directory = try FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true).appendingPathComponent("HandyWorkspaceSearch", isDirectory: true)
