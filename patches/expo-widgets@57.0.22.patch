+import ActivityKit
+import Foundation
+import UIKit
+import UserNotifications
+
+// Host-app only. The widget's LiveActivityIntent calls this through an ObjC
+// runtime bridge; no network, credentials or Activity.request run in the extension.
+@objc(HandyWorkspaceSearch)
+final class HandyWorkspaceSearch: NSObject, HandyWorkspaceSearchIntentHandler {
+  private static let prefix = "handy-workspace-search-v1:"
+  private static let category = "handy-workspace-search-input-v1"
+  private static let submit = "handy-workspace-search-submit"
+  private struct SafeError: LocalizedError {
+    let message: String
+    var errorDescription: String? { message }
+  }
+  private struct Workspace: Codable {
+    let id: String
+    let name: String?
+    let updated_at: String?
+    let archived: Bool?
+    let worktree_deleted: Bool?
+    var title: String { String((name?.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty == false ? name! : id).prefix(60)) }
+  }
+  private struct Session: Decodable {
+    let id: String
+    let workspace_id: String
+    let name: String?
+    let executor: String?
+    let created_at: String
+  }
+  private struct Search: Codable {
+    var id: String
+    var revision: String
+    let originId: String
+    let presetId: String
+    let action: String
+    var query = ""
+    var workspaces: [Workspace] = []
+    var page = 0
+    var selecting = false
+    var selected: String?
+  }
+
+  private static func safeMessage(_ error: Error) -> String {
+    (error as? SafeError)?.message ?? (error as? HandyActivityCoordinator.Failure)?.message ?? "Could not complete workspace search. Check the connection and try again."
+  }
+
+  // End exactly once on completion OR expiration. Cancellation propagates to
+  // URLSession.data(for:); unfinished read-only searches remain retryable.
+  @MainActor
+  private static func withRuntime<T>(_ operation: @escaping @MainActor () async throws -> T) async throws -> T {
+    var identifier = UIBackgroundTaskIdentifier.invalid
+    let task = Task<T, Error> { @MainActor in try Task.checkCancellation(); return try await operation() }
+    @MainActor func finish() {
+      if identifier != .invalid {
+        UIApplication.shared.endBackgroundTask(identifier)
+        identifier = .invalid
+      }
+    }
+    identifier = UIApplication.shared.beginBackgroundTask(withName: "Handy workspace search") {
+      Task { @MainActor in task.cancel(); finish() }
+    }
+    defer { finish() }
+    return try await task.value
+  }
+
+  @objc(handleTarget:completion:)
+  static func handleTarget(_ target: String, completion: @escaping (String?) -> Void) {
+    Task { @MainActor in
+      guard #available(iOS 17.0, *) else { completion("Requires iOS 17 or later."); return }
+      do {
+        try await withRuntime {
+          if target.hasPrefix(HandyActivityCoordinator.prefix) { try await HandyActivityCoordinator.perform(target) }
+          else { try await perform(target) }
+        }
+        completion(nil)
+      }
+      catch { completion(safeMessage(error)) }
+    }
+  }
+
+  static func handle(response: UNNotificationResponse, notification: [String: Any], completion: @escaping () -> Void) -> Bool {
+    // Fresh workspace message body taps go straight to the VD browser, including
+    // a cold-start response. Text-input actions still use the journaled sender.
+    if response.actionIdentifier == UNNotificationDefaultActionIdentifier,
+       let data = notification["data"] as? [String: Any], let text = data["workspaceBrowserUrl"] as? String,
+       let url = URL(string: text), ["http", "https"].contains(url.scheme?.lowercased() ?? ""),
+       url.host != nil, url.user == nil, url.password == nil, url.query == nil, url.fragment == nil,
+       url.path.hasPrefix("/workspaces/") {
+      Task { @MainActor in UIApplication.shared.open(url, options: [:]) { _ in completion() } }
