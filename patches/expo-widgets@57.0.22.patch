+          let browserURL = URL(string: "/workspaces/\(encoded)", relativeTo: base)?.absoluteURL else { throw SafeError(message: "The workspace browser destination is unavailable.") }
+    let capture: [String: Any] = ["actionId": id, "presetId": search.presetId, "title": "\(workspace.title) · \(label)", "actions": String(decoding: try JSONSerialization.data(withJSONObject: rows), as: UTF8.self), "backgroundRequest": true, "workspaceBrowserUrl": browserURL.absoluteString]
+    _ = try await HandyNoteCapture.post(target: "handy-note-capture-v1:" + String(decoding: try JSONSerialization.data(withJSONObject: capture), as: UTF8.self))
