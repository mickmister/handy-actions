+        try await withRuntime {
+          var search = try read(id)
+          guard search.revision == revision, try HandyActivityCoordinator.containsSearch(id) else { return } // duplicate/stale callback
+          search.revision = UUID().uuidString
+          search.query = String(response.userText.trimmingCharacters(in: .whitespacesAndNewlines).prefix(80))
+          search.workspaces = []; search.page = 0; search.selected = nil; search.selecting = false
+          try save(search)
+          guard currentSearch(search) else { throw SafeError(message: "The shared activity expired or was dismissed. Tap this notification to restore it in the app; your query is kept.") }
+          guard response.userText.trimmingCharacters(in: .whitespacesAndNewlines).count <= 80 else { throw SafeError(message: "Use at most 80 characters for a workspace-name search.") }
+          try await query(search)
+          if !search.query.isEmpty, try read(id).revision == search.revision, currentSearch(search) {
+            UNUserNotificationCenter.current().removeDeliveredNotifications(withIdentifiers: [response.notification.request.identifier])
+          }
+        }
+      } catch {
+        if let search = try? read(id) {
+          try? await postQuery(search, message: safeMessage(error), text: response.userText)
+        }
+      }
+      completion()
+    }
+    return true
+  }
+
+  @MainActor @available(iOS 17.0, *)
+  static func begin(action: String, presetId: String, query text: String?) async throws -> String {
+    try await withRuntime { try await beginSearch(action: action, presetId: presetId, query: text) }
+  }
+
+  @MainActor @available(iOS 17.0, *)
+  static func recent(originId: String, workspaceId: String?, title: String?) async throws {
+    let action: [String: Any] = ["id": "recent-workspaces", "name": "Search VD workspaces", "payload": ["type": "vd-workspace-search", "originId": originId]]
+    let actionText = String(decoding: try JSONSerialization.data(withJSONObject: action), as: UTF8.self)
+    guard let workspaceId else { _ = try await beginSearch(action: actionText, presetId: "recent-workspaces", query: nil); return }
+    let workspace = Workspace(id: workspaceId, name: title, updated_at: nil, archived: nil, worktree_deleted: nil)
+    var search = Search(id: UUID().uuidString, revision: UUID().uuidString, originId: originId, presetId: "recent-workspaces", action: actionText)
+    search.workspaces = [workspace]; search.selecting = true
+    try save(search)
+    try await HandyActivityCoordinator.beginSearch(id: search.id, props: content(search, message: "Finding newest session…"))
+    do { try await select(search, workspace: workspace) }
+    catch {
+      if currentSearch(search) { search.selecting = false; try save(search); try? await publish(search, message: safeMessage(error)) }
+      throw error
+    }
+  }
+
+  @MainActor @available(iOS 17.0, *)
+  private static func beginSearch(action: String, presetId: String, query text: String?) async throws -> String {
+    if let text, text.trimmingCharacters(in: .whitespacesAndNewlines).count > 80 { throw SafeError(message: "Use at most 80 characters for a workspace-name search.") }
+    guard let row = try JSONSerialization.jsonObject(with: Data(action.utf8)) as? [String: Any],
+          let actionId = row["id"] as? String, !actionId.isEmpty,
+          let payload = row["payload"] as? [String: Any], payload["type"] as? String == "vd-workspace-search",
+          let originId = payload["originId"] as? String, !originId.isEmpty else {
+      throw SafeError(message: "Choose a saved VD origin for this search action.")
+    }
+    let settings = await UNUserNotificationCenter.current().notificationSettings()
+    try Task.checkCancellation()
+    guard settings.authorizationStatus == .authorized || settings.authorizationStatus == .provisional else {
+      throw SafeError(message: "Allow notifications in Settings to search from the Lock Screen.")
+    }
+    guard ActivityAuthorizationInfo().areActivitiesEnabled else { throw SafeError(message: "Allow Live Activities for Handy Actions in iOS Settings.") }
+    // Keep searches on disk for cold-start intents, without persisting credentials.
+    let folder = try directory()
+    for file in try FileManager.default.contentsOfDirectory(at: folder, includingPropertiesForKeys: [.contentModificationDateKey]) {
+      if let date = try? file.resourceValues(forKeys: [.contentModificationDateKey]).contentModificationDate,
+         date < Date().addingTimeInterval(-86400) { try? FileManager.default.removeItem(at: file) }
+    }
+    var search = Search(id: UUID().uuidString, revision: UUID().uuidString, originId: originId, presetId: presetId, action: action)
+    if let text { search.query = String(text.trimmingCharacters(in: .whitespacesAndNewlines).prefix(80)) }
+    try save(search)
+    let props = try content(search, message: text == nil ? "Enter a workspace name in the search notification." : "Searching…")
+    // Admission happens ONLY here, from foreground or an eligible LiveActivityIntent,
+    // before the user submits notification input. The reply only updates this activity.
+    try await HandyActivityCoordinator.beginSearch(id: search.id, props: props)
+    guard currentSearch(search) else { throw SafeError(message: "A newer search replaced this one. Use the current search activity.") }
+    if text != nil { try await query(search); return "Choose a workspace in the search-results Live Activity." }
+    try await postQuery(search)
+    return "Search notification posted. Expand it and choose Search workspaces."
+  }
+
+  @MainActor @available(iOS 17.0, *)
+  static func perform(_ target: String) async throws {
+    guard target.hasPrefix(prefix),
+          let value = try JSONSerialization.jsonObject(with: Data(target.dropFirst(prefix.count).utf8)) as? [String: Any],
+          let operation = value["operation"] as? String else { throw SafeError(message: "Refresh this search action in Handy Actions.") }
+    if operation == "begin", let action = value["action"], let preset = value["presetId"] as? String {
+      let encoded = try JSONSerialization.data(withJSONObject: action)
+      _ = try await beginSearch(action: String(decoding: encoded, as: UTF8.self), presetId: preset, query: nil)
+      return
+    }
+    guard let id = value["searchId"] as? String, let revision = value["revision"] as? String else { throw SafeError(message: "Start a new workspace search.") }
+    var search = try read(id)
+    guard search.revision == revision, currentSearch(search) else { throw SafeError(message: "These results are no longer current. Start a new search.") }
+    if operation == "again" {
+      search.revision = UUID().uuidString; search.workspaces = []; search.query = ""; search.page = 0; search.selected = nil; search.selecting = false
+      try save(search)
+      try await publish(search, message: "Enter a workspace name in the search notification.")
+      try await postQuery(search)
+    } else if operation == "page", let page = value["page"] as? Int {
+      search.page = max(0, min(page, max(0, (search.workspaces.count - 1) / 3)))
+      try save(search); try await publish(search)
+    } else if operation == "select", let index = value["index"] as? Int, search.workspaces.indices.contains(index) {
+      if search.selected != nil { try await publish(search, message: "Expand the message notification to send, or search again."); return }
+      guard !search.selecting else { return }
+      search.selecting = true; try save(search)
+      do { try await select(search, workspace: search.workspaces[index]) }
+      catch {
+        var latest = try read(id)
+        if latest.revision == revision {
+          latest.selecting = false; try save(latest)
+          try? await publish(latest, message: safeMessage(error))
+        }
+        throw error
+      }
+    }
+  }
+
+  private static func directory() throws -> URL {
+    let directory = try FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true).appendingPathComponent("HandyWorkspaceSearch", isDirectory: true)
+    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true, attributes: [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication])
+    return directory
+  }
+  private static func file(_ id: String) throws -> URL {
+    guard UUID(uuidString: id) != nil else { throw SafeError(message: "Start a new workspace search.") }
+    return try directory().appendingPathComponent(id + ".json")
+  }
+  private static func read(_ id: String) throws -> Search { try JSONDecoder().decode(Search.self, from: Data(contentsOf: file(id))) }
+  private static func save(_ search: Search) throws {
+    try JSONEncoder().encode(search).write(to: file(search.id), options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+  }
+  @MainActor @available(iOS 16.2, *)
+  private static func currentSearch(_ search: Search) -> Bool { (try? HandyActivityCoordinator.isCurrentSearch(search.id)) == true }
+  private static func target(_ search: Search, _ operation: String, _ extra: [String: Any] = [:]) throws -> String {
+    var value: [String: Any] = ["operation": operation, "searchId": search.id, "revision": search.revision]
+    extra.forEach { value[$0.key] = $0.value }
+    return prefix + String(decoding: try JSONSerialization.data(withJSONObject: value), as: UTF8.self)
+  }
+  private static func content(_ search: Search, message: String = "") throws -> [String: Any] {
+    let start = search.page * 3
+    let end = min(start + 3, search.workspaces.count)
+    var props: [String: Any] = ["searchId": search.id, "title": search.query.isEmpty ? "Search VD workspaces" : "\(start + (end > start ? 1 : 0))–\(end) of \(search.workspaces.count): \(String(search.query.prefix(32)))",
+      "message": String(message.prefix(120)), "results": try (start..<max(start, end)).map { index in
+        ["title": search.workspaces[index].title, "target": try target(search, "select", ["index": index])]
+      }, "searchAgain": try target(search, "again")]
+    if start > 0 { props["previous"] = try target(search, "page", ["page": search.page - 1]) }
+    if end < search.workspaces.count { props["next"] = try target(search, "page", ["page": search.page + 1]) }
+    return props
+  }
+  @MainActor @available(iOS 17.0, *)
+  private static func publish(_ search: Search, message: String = "") async throws {
+    guard try read(search.id).revision == search.revision, currentSearch(search) else { return }
+    try await HandyActivityCoordinator.publishSearch(id: search.id, props: content(search, message: message), ifCurrent: { (try? read(search.id).revision) == search.revision })
+  }
+
+  private static func connection(_ id: String) throws -> (HandyBackgroundDelivery, [String: Any], URLSession) {
+    let worker = HandyBackgroundDelivery()
+    let profile = try worker.profile(id)
+    let configuration = URLSessionConfiguration.ephemeral
+    configuration.httpCookieStorage = nil; configuration.urlCredentialStorage = nil; configuration.urlCache = nil
+    configuration.timeoutIntervalForResource = 20
+    return (worker, profile, URLSession(configuration: configuration, delegate: worker, delegateQueue: nil))
+  }
+  private static func validId(_ id: String) -> Bool { !id.isEmpty && id != "." && id != ".." && id.utf8.count <= 512 }
+  private static func date(_ text: String?) -> Date {
+    let formatter = ISO8601DateFormatter()
+    formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+    if let text, let value = formatter.date(from: text) { return value }
+    formatter.formatOptions = [.withInternetDateTime]
+    return text.flatMap { formatter.date(from: $0) } ?? .distantPast
+  }
+  private static func workspaces(_ worker: HandyBackgroundDelivery, _ profile: [String: Any], _ session: URLSession) async throws -> [Workspace] {
+    let result = try await worker.request(session, profile, "/api/workspaces")
+    let values = try JSONDecoder().decode([Workspace].self, from: JSONSerialization.data(withJSONObject: result))
+    var seen = Set<String>()
+    return values.filter { validId($0.id) && $0.archived != true && $0.worktree_deleted != true && seen.insert($0.id).inserted }
