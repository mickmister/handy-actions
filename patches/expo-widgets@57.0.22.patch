+    categories.insert(category)
+    categories = Set(categories.filter { $0.identifier != "handy-action-editor-v1" })
+    categories.insert(UNNotificationCategory(identifier: "handy-action-editor-v1", actions: [], intentIdentifiers: [], options: []))
+    if localSave {
