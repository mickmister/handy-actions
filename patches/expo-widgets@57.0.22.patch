+private enum HandyNoteCapture {
+  private static let prefix = "handy-note-capture-v1:"
+  private static let categoryID = "handy-text-input"
+
+  private struct Capture: Decodable {
+    let actionId: String
+    let presetId: String
+    let title: String
+    // Same snapshot consumed by actionFromNotificationRowsData in the host app.
+    let actions: String
+    let localSave: Bool?
+  }
+
+  static func post(target: String?) async throws -> Bool {
+    guard let target, target.hasPrefix(prefix) else { return false }
+    let capture = try JSONDecoder().decode(
+      Capture.self, from: Data(target.dropFirst(prefix.count).utf8)
+    )
+    guard !capture.actionId.isEmpty, !capture.presetId.isEmpty,
+          let rowsData = capture.actions.data(using: .utf8),
+          let rows = try JSONSerialization.jsonObject(with: rowsData) as? [[String: Any]],
+          let row = rows.first, row["id"] as? String == capture.actionId,
+          let payload = row["payload"] as? [String: Any],
+          payload["type"] as? String == "text-input" else {
+      throw NSError(domain: "HandyNoteCapture", code: 1, userInfo: [
+        NSLocalizedDescriptionKey: "Refresh Handy Actions to rebuild this note action."
+      ])
+    }
+
+    let center = UNUserNotificationCenter.current()
+    let settings = await center.notificationSettings()
+    guard settings.authorizationStatus == .authorized ||
+          settings.authorizationStatus == .provisional else {
+      // Never prompt or open the app implicitly from a Lock Screen button.
+      throw NSError(domain: "HandyNoteCapture", code: 2, userInfo: [
+        NSLocalizedDescriptionKey: "Allow notifications in Settings, then try Add Note again."
+      ])
+    }
+
+    // Local replies are persisted by Notifee's native response callback. App
+    // deep-link destinations retain foreground handoff; never switch silently.
+    let localSave = capture.localSave == true
+    let selectedCategory = localSave ? "handy-text-input-local-v1" : categoryID
+    let reply = UNTextInputNotificationAction(
+      identifier: "handy-input-submit", title: "Add Note", options: localSave ? [] : [.foreground],
+      textInputButtonTitle: localSave ? "Save" : "Send", textInputPlaceholder: "Write a note…"
+    )
+    let category = UNNotificationCategory(
+      identifier: selectedCategory, actions: [reply], intentIdentifiers: [], options: []
+    )
+    var categories = await center.notificationCategories()
+    categories = Set(categories.filter { $0.identifier != selectedCategory })
+    categories.insert(category)
+    if localSave {
+      let retry = UNNotificationAction(identifier: "handy-local-retry", title: "Retry save", options: [])
+      categories = Set(categories.filter { $0.identifier != "handy-text-input-local-recovery-v1" })
+      categories.insert(UNNotificationCategory(
+        identifier: "handy-text-input-local-recovery-v1", actions: [retry, reply], intentIdentifiers: [], options: []
+      ))
+    }
+    center.setNotificationCategories(categories)
+
+    let submissionID = UUID().uuidString
+    let notificationID = "handy-input-\(submissionID)"
+    let body = "Expand this notification and select Add Note to type."
+    var data: [String: String] = [
+      "captureActionId": capture.actionId, "presetId": capture.presetId,
+      "submissionId": submissionID, "actions": capture.actions
+    ]
+    if localSave { data["localNoteDestination"] = "1" }
+    let notification: [String: Any] = [
+      "id": notificationID, "title": capture.title, "body": body, "data": data,
+      "ios": ["categoryId": selectedCategory, "foregroundPresentationOptions": [
+        "banner": true, "list": true, "sound": false, "badge": false
+      ]]
+    ]
+    let content = UNMutableNotificationContent()
+    content.title = capture.title
+    content.body = body
+    content.categoryIdentifier = selectedCategory
+    // Notifee 9.1.8 reads this envelope on response/cold start. This lets the
+    // existing reply handler retain its snapshot, pending queue and dedupe.
+    content.userInfo = data.reduce(into: [String: Any]()) { $0[$1.key] = $1.value }
+    content.userInfo["__notifee_notification"] = notification
+    try await center.add(UNNotificationRequest(
+      identifier: notificationID, content: content, trigger: nil
+    ))
+    return true
+  }
+}
