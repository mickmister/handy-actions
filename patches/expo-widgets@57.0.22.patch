new file mode 100644
index 0000000000000000000000000000000000000000..93cad949afecefea4b17eb3b63796266fe2bd150
--- /dev/null
+++ b/ios/HandyActivityCoordinator.swift
@@ -0,0 +1,265 @@
+import ActivityKit
+import Foundation
+import UIKit
+
+// The ONLY Handy Actions Activity.request owner. All mutations (including native
+// intents and JS refresh/renewal) share this queue across ActivityKit await points.
+@MainActor
+enum HandyActivityCoordinator {
+  static let name = "SharedHandyActivity"
+  static let prefix = "handy-activity-v1:"
+  private static var tail: Task<Void, Never>?
+  private struct State: Codable {
+    var configuration = "{}"
+    var revision = UUID().uuidString
+    var view = "actions"
+    var previousView = "actions"
+    var presetId = ""
+    var page = 0
+    var searchId: String?
+    var searchProps: String?
+  }
+  struct Failure: LocalizedError {
+    let message: String
+    var errorDescription: String? { message }
+  }
+  private static func transaction<T>(_ operation: @escaping @MainActor () async throws -> T) async throws -> T {
+    let previous = tail
+    let task = Task<T, Error> { @MainActor in
+      await previous?.value
+      return try await operation()
+    }
+    tail = Task { @MainActor in _ = try? await task.value }
+    return try await task.value
+  }
+  private static func file() throws -> URL {
+    let directory = try FileManager.default.url(for: .applicationSupportDirectory, in: .userDomainMask, appropriateFor: nil, create: true)
+    return directory.appendingPathComponent("HandySharedActivity-v1.json")
+  }
+  private static func read() throws -> State {
+    let url = try file()
+    return FileManager.default.fileExists(atPath: url.path) ? try JSONDecoder().decode(State.self, from: Data(contentsOf: url)) : State()
+  }
+  private static func save(_ state: State) throws {
+    try JSONEncoder().encode(state).write(to: file(), options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+  }
+  private static func object(_ text: String) throws -> [String: Any] {
+    guard let value = try JSONSerialization.jsonObject(with: Data(text.utf8)) as? [String: Any] else { throw Failure(message: "Open Handy Actions to refresh the activity configuration.") }
+    return value
+  }
+  private static func encode(_ value: Any) throws -> String { String(decoding: try JSONSerialization.data(withJSONObject: value), as: UTF8.self) }
+  private static func normalize(_ state: inout State, _ config: [String: Any]) {
+    if !["actions", "workspaces", "search"].contains(state.view) { state.view = "actions" }
+    if !["actions", "workspaces"].contains(state.previousView) { state.previousView = "actions" }
+    let presets = config["presets"] as? [[String: Any]] ?? []
+    if !presets.contains(where: { $0["id"] as? String == state.presetId }) {
+      state.presetId = presets.first?["id"] as? String ?? ""; state.page = 0
+    }
+    let actions = presets.first(where: { $0["id"] as? String == state.presetId })?["actions"] as? [[String: Any]] ?? []
+    state.page = max(0, min(state.page, max(0, (actions.count - 1) / 4)))
+    if state.view == "actions", presets.isEmpty, config["recent"] != nil { state.view = "workspaces" }
+  }
+  @available(iOS 16.2, *)
+  private static func activities() -> [Activity<LiveActivityAttributes>] {
+    // ActivityKit enumeration is already scoped to this app. Retire unknown
+    // legacy ExpoWidgets layouts too, rather than leaving an extra live card.
+    Activity<LiveActivityAttributes>.activities.filter { $0.activityState == .active || $0.activityState == .stale }
+  }
+  @available(iOS 16.2, *)
+  private static func reconcile(_ state: State, allowStart: Bool, renew: Bool = false) async throws {
+    if #unavailable(iOS 17.0) {
+      for activity in activities() { await activity.end(nil, dismissalPolicy: .immediate) }
+      return
+    }
+    let config = try object(state.configuration)
+    let useful = !(config["presets"] as? [Any] ?? []).isEmpty || config["recent"] != nil || state.searchId != nil
+    let enabled = config["enabled"] as? Bool == true && useful
+    let instances = activities()
+    let keep = enabled && !renew ? instances.first(where: { $0.content.state.name == name }) : nil
+    for activity in instances where activity.id != keep?.id { await activity.end(nil, dismissalPolicy: .immediate) }
+    // Do not allocate after a failed/incomplete retirement, even across migration.
+    guard activities().allSatisfy({ $0.id == keep?.id }) else { throw Failure(message: "Could not retire an old activity. Refresh Lock Screen again.") }
+    guard enabled else { return }
+    let props = try presentation(state, config)
+    let content = ActivityContent(state: LiveActivityAttributes.ContentState(name: name, props: try encode(props)), staleDate: Date().addingTimeInterval(1800))
+    if let keep { await keep.update(content); return }
+    guard allowStart || UIApplication.shared.applicationState == .active else {
+      throw Failure(message: "Open Handy Actions or tap a Live Activity action to restore the shared activity.")
+    }
+    guard ActivityAuthorizationInfo().areActivitiesEnabled else { throw Failure(message: "Allow Live Activities for Handy Actions in iOS Settings.") }
+    do {
+      _ = try Activity.request(attributes: LiveActivityAttributes(url: config["openUrl"] as? String), content: content, pushType: nil)
+    } catch { throw Failure(message: "iOS could not start the shared activity. Check Live Activity permission or dismiss an unused activity and retry.") }
+  }
+  @available(iOS 16.2, *)
+  static func sync(_ configuration: String, renew: Bool) async throws -> String {
+    try await transaction {
+      let config = try object(configuration)
+      var state = try read()
+      if state.configuration != configuration { state.revision = UUID().uuidString }
+      state.configuration = configuration
+      if config["enabled"] as? Bool != true { state.searchId = nil; state.searchProps = nil; state.view = "actions" }
+      normalize(&state, config); try save(state)
+      try await reconcile(state, allowStart: false, renew: renew)
+      if #unavailable(iOS 17.0) { return "The shared Live Activity requires iOS 17 or later. Actions remain available in the app." }
+      return activities().isEmpty ? "Live Activity off or no enabled content." : "One Handy Actions Live Activity refreshed (\(state.view))."
+    }
+  }
+  @available(iOS 16.2, *)
+  static func beginSearch(id: String, props: [String: Any]) async throws {
+    try await transaction {
+      var state = try read()
+      let config = try object(state.configuration)
+      guard config["enabled"] as? Bool == true else { throw Failure(message: "Enable Live Activities in Handy Actions Settings first.") }
+      if state.view != "search" { state.previousView = state.view }
+      state.view = "search"; state.searchId = id; state.searchProps = try encode(props)
+      try save(state)
+      try await reconcile(state, allowStart: true)
+    }
+  }
+  @available(iOS 16.2, *)
+  static func isCurrentSearch(_ id: String) throws -> Bool {
+    try containsSearch(id) && !activities().filter { $0.content.state.name == name }.isEmpty
+  }
+  static func containsSearch(_ id: String) throws -> Bool {
+    let state = try read()
+    let config = try object(state.configuration)
+    return state.searchId == id && config["enabled"] as? Bool == true
+  }
+  @available(iOS 16.2, *)
+  static func publishSearch(id: String, props: [String: Any], ifCurrent: @escaping @MainActor () -> Bool) async throws {
+    try await transaction {
+      var state = try read()
+      guard state.searchId == id, ifCurrent() else { return }
+      guard !activities().filter({ $0.content.state.name == name }).isEmpty else { throw Failure(message: "Search activity was dismissed. Start again from the app or widget.") }
+      state.searchProps = try encode(props); try save(state)
+      // Preserve the selected view even when a query finishes after Back/Home.
+      try await reconcile(state, allowStart: false)
+    }
+  }
+  @available(iOS 16.2, *)
+  static func completeSearch(_ id: String, ifCurrent: @escaping @MainActor () -> Bool) async throws {
+    try await transaction {
+      var state = try read()
+      guard state.searchId == id, ifCurrent() else { return }
+      if state.view == "search" { state.view = state.previousView }
+      state.searchId = nil; state.searchProps = nil
+      normalize(&state, try object(state.configuration)); try save(state)
+      // A user may dismiss the card while the selected session is resolving.
+      // Still deliver the explicitly requested message notification; don't undo
+      // that dismissal by starting another activity from the callback.
+      if !activities().isEmpty { try await reconcile(state, allowStart: false) }
+    }
+  }
+  private static func target(_ state: State, _ operation: String, _ extra: [String: Any] = [:]) throws -> String {
+    var value: [String: Any] = ["operation": operation, "revision": state.revision]
+    extra.forEach { value[$0.key] = $0.value }
+    return prefix + (try encode(value))
+  }
+  private static func presentation(_ state: State, _ config: [String: Any]) throws -> [String: Any] {
+    var props: [String: Any] = ["view": state.view, "title": "Handy Actions", "message": ""]
+    if let theme = config["theme"] { props["theme"] = theme }
+    var navigation: [[String: String]] = []
+    func control(_ title: String, _ operation: String, _ extra: [String: Any] = [:]) throws -> [String: String] { ["title": title, "target": try target(state, operation, extra)] }
+    if state.view == "search", let text = state.searchProps {
+      let search = try object(text)
+      props["title"] = search["title"]; props["message"] = search["message"]; props["results"] = search["results"]
+      navigation.append(try control("Back", "back"))
+      if let again = search["searchAgain"] as? String { navigation.append(["title": "Search", "target": again]) }
+      if search["message"] as? String == "" {
+        if let previous = search["previous"] as? String { navigation.append(["title": "‹", "target": previous]) }
+        if let next = search["next"] as? String { navigation.append(["title": "›", "target": next]) }
+      }
+    } else if state.view == "workspaces" {
+      props["title"] = "Recent VD workspaces"
+      if let recent = config["recent"] as? [String: Any] {
+        props["message"] = recent["message"] ?? ""
+        props["results"] = try (recent["links"] as? [[String: Any]] ?? []).prefix(3).enumerated().map { index, link in
+          ["title": String((link["title"] as? String ?? "Workspace").prefix(60)), "target": try target(state, "recent", ["index": index])]
+        }
+        if let originId = recent["originId"] as? String, !originId.isEmpty {
+          navigation.append(try control("Search", state.searchId == nil ? "search" : "view", state.searchId == nil ? [:] : ["view": "search"]))
+        }
+      } else { props["message"] = "Enable recent VD workspaces and choose an origin in Settings." }
+      if !(config["presets"] as? [Any] ?? []).isEmpty { navigation.insert(try control("Actions", "view", ["view": "actions"]), at: 0) }
+    } else {
+      let presets = config["presets"] as? [[String: Any]] ?? []
+      if let index = presets.firstIndex(where: { $0["id"] as? String == state.presetId }) {
+        let preset = presets[index]
+        let actions = preset["actions"] as? [[String: Any]] ?? []
+        let start = state.page * 4
+        props["title"] = String((preset["name"] as? String ?? "Actions").prefix(60)) + " · \(state.page + 1)/\(max(1, (actions.count + 3) / 4))"
+        var rows: [[[String: Any]]] = []
+        for action in actions.dropFirst(start).prefix(4) {
+          var link: [String: Any] = ["title": String((action["title"] as? String ?? "Action").prefix(48)), "url": action["url"] as? String ?? config["openUrl"] as? String ?? ""]
+          if action["captureTarget"] is String { link["captureTarget"] = try target(state, "action", ["presetId": state.presetId, "actionId": action["id"] as? String ?? ""]) }
+          if let glyph = action["siteGlyph"] { link["siteGlyph"] = glyph }
+          if let symbol = action["systemImage"] { link["systemImage"] = symbol }
+          if rows.isEmpty || rows[rows.count - 1].count == 2 { rows.append([]) }
+          rows[rows.count - 1].append(link)
+        }
+        props["rows"] = rows
+        if state.page > 0 || index > 0 { navigation.append(try control("‹", "page", ["direction": -1])) }
+        if start + 4 < actions.count || index + 1 < presets.count { navigation.append(try control("›", "page", ["direction": 1])) }
+      } else { props["message"] = "Enable a preset with actions in the app." }
+      navigation.insert(try control("Workspaces", "view", ["view": "workspaces"]), at: 0)
+      if state.searchId != nil { navigation.append(try control("Search", "view", ["view": "search"])) }
+    }
+    props["navigation"] = navigation
+    let bytes = try JSONSerialization.data(withJSONObject: ["name": name, "props": try encode(props)])
+    if bytes.count > 3400 {
+      props.removeValue(forKey: "rows"); props.removeValue(forKey: "results")
+      props["message"] = "This page exceeds the Lock Screen size budget. Open the app to use its actions."
+    }
+    guard try JSONSerialization.data(withJSONObject: ["name": name, "props": encode(props)]).count <= 3500 else { throw Failure(message: "Activity content is too large. Shorten labels and refresh.") }
+    return props
+  }
+  @available(iOS 17.0, *)
+  static func perform(_ text: String) async throws {
+    let value = try object(String(text.dropFirst(prefix.count)))
+    // Resolve a snapshot under the same queue as config writes. Network/capture
+    // work happens AFTER this transaction so it cannot block Home/navigation.
+    let command: [String: Any] = try await transaction {
+      var state = try read()
+      guard value["revision"] as? String == state.revision else { throw Failure(message: "These controls changed. Try the updated activity.") }
+      let config = try object(state.configuration)
+      guard config["enabled"] as? Bool == true else { throw Failure(message: "Live Activities are disabled in Handy Actions.") }
+      let operation = value["operation"] as? String ?? ""
+      if operation == "action" {
+        let presets = config["presets"] as? [[String: Any]] ?? []
+        let preset = presets.first { $0["id"] as? String == value["presetId"] as? String }
+        guard let action = (preset?["actions"] as? [[String: Any]])?.first(where: { $0["id"] as? String == value["actionId"] as? String }), let target = action["captureTarget"] as? String else { throw Failure(message: "This action changed. Refresh the activity.") }
+        return ["captureTarget": target]
+      }
+      if operation == "recent" || operation == "search" {
+        guard let recent = config["recent"] as? [String: Any], let origin = recent["originId"] as? String, !origin.isEmpty else { throw Failure(message: "Choose a VD origin in Settings.") }
+        if operation == "search" { return ["originId": origin] }
+        let links = recent["links"] as? [[String: Any]] ?? []
+        guard let index = value["index"] as? Int, links.indices.contains(index), let id = links[index]["id"] as? String else { throw Failure(message: "Workspace results changed. Refresh and try again.") }
+        return ["originId": origin, "workspaceId": id, "title": links[index]["title"] as? String ?? "Workspace"]
+      }
+      if operation == "view", let view = value["view"] as? String, ["actions", "workspaces", "search"].contains(view), view != "search" || state.searchId != nil { state.view = view }
+      if operation == "back" { state.view = state.previousView }
+      if operation == "page", let direction = value["direction"] as? Int, [-1, 1].contains(direction) {
+        let presets = config["presets"] as? [[String: Any]] ?? []
+        if let index = presets.firstIndex(where: { $0["id"] as? String == state.presetId }) {
+          let count = (presets[index]["actions"] as? [Any] ?? []).count
+          if direction < 0, state.page == 0, index > 0 {
+            state.presetId = presets[index - 1]["id"] as? String ?? ""
+            state.page = max(0, ((presets[index - 1]["actions"] as? [Any] ?? []).count - 1) / 4)
+          } else if direction > 0, (state.page + 1) * 4 >= count, index + 1 < presets.count { state.presetId = presets[index + 1]["id"] as? String ?? ""; state.page = 0 }
+          else { state.page += direction }
+        }
+      }
+      normalize(&state, config); try save(state)
+      try await reconcile(state, allowStart: true)
+      return [:]
+    }
+    if let capture = command["captureTarget"] as? String {
+      if capture.hasPrefix("handy-workspace-search-v1:") { try await HandyWorkspaceSearch.perform(capture) }
+      else { _ = try await HandyNoteCapture.post(target: capture) }
+    } else if let origin = command["originId"] as? String {
+      try await HandyWorkspaceSearch.recent(originId: origin, workspaceId: command["workspaceId"] as? String, title: command["title"] as? String)
+    }
+  }
+}
diff --git a/ios/HandyBackgroundDelivery.swift b/ios/HandyBackgroundDelivery.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d11acf108cba4a723714dc6236c0983a0bf2ad3a
--- /dev/null
+++ b/ios/HandyBackgroundDelivery.swift
@@ -0,0 +1,258 @@
+import Foundation
+import Security
+import CryptoKit
+import UserNotifications
+
+// Called by the pinned Notifee callback before React event delivery. This class
+// lives in the host, not the widget extension; credentials never enter activities.
+@objc(HandyBackgroundDelivery)
+final class HandyBackgroundDelivery: NSObject, URLSessionTaskDelegate {
+  private static let gate = NSLock()
+  private enum Failure: Error { case retained(String) }
+  private let deadline = Date().addingTimeInterval(20)
+
+  func urlSession(_ session: URLSession, task: URLSessionTask,
+                  willPerformHTTPRedirection response: HTTPURLResponse,
+                  newRequest request: URLRequest,
+                  completionHandler: @escaping (URLRequest?) -> Void) {
+    completionHandler(nil) // Never forward origin credentials through redirects.
+  }
+
+  private static func folder() throws -> URL {
+    let directory = try FileManager.default.url(for: .applicationSupportDirectory,
+      in: .userDomainMask, appropriateFor: nil, create: true)
+      .appendingPathComponent("HandyActionsActionInbox", isDirectory: true)
+    try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true,
+      attributes: [.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication])
+    return directory
+  }
+
+  private static func file(_ id: String) throws -> URL {
+    let digest = SHA256.hash(data: Data(id.utf8)).map { String(format: "%02x", $0) }.joined()
+    return try folder().appendingPathComponent("\(digest).json")
+  }
+
+  private static func write(_ record: [String: Any], to file: URL) throws {
+    try JSONSerialization.data(withJSONObject: record).write(to: file,
+      options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+  }
+
+  private static func finish(_ record: [String: Any], _ id: String) throws {
+    gate.lock(); defer { gate.unlock() }
+    try write(record, to: file(id))
+  }
+
+  static func readInbox() throws -> [[String: Any]] {
+    gate.lock(); defer { gate.unlock() }
+    return try FileManager.default.contentsOfDirectory(at: folder(), includingPropertiesForKeys: nil)
+      .filter { $0.pathExtension == "json" }.compactMap { file in
+        guard let record = try JSONSerialization.jsonObject(with: Data(contentsOf: file)) as? [String: Any] else {
+          throw Failure.retained("A background draft could not be read; its file was retained.")
+        }
+        // Do not import/ack a live task. A killed process leaves a recoverable
+        // uncertain draft after the bounded native execution window has elapsed.
+        if record["inFlight"] as? Bool == true,
+           let started = record["startedAt"] as? Double, Date().timeIntervalSince1970 - started < 30 { return nil }
+        return record
+      }
+  }
+
+  static func acknowledge(_ id: String) throws {
+    gate.lock(); defer { gate.unlock() }
+    let url = try file(id)
+    if FileManager.default.fileExists(atPath: url.path) { try FileManager.default.removeItem(at: url) }
+  }
+
+  @objc(handleResponse:notification:completion:)
+  static func handle(response: UNNotificationResponse, notification: [String: Any], completion: @escaping () -> Void) -> Bool {
+    if HandyWorkspaceSearch.handle(response: response, notification: notification, completion: completion) { return true }
+    guard let data = notification["data"] as? [String: Any] else { return false }
+    let press = response.actionIdentifier
+    let actionId: String
+    if press == "handy-input-submit", data["backgroundRequest"] as? String == "1",
+       let id = data["captureActionId"] as? String { actionId = id }
+    else if press.hasPrefix("handy-action:"), let encoded = data["backgroundActionIds"] as? String,
+            let ids = try? JSONSerialization.jsonObject(with: Data(encoded.utf8)) as? [String],
+            ids.contains(String(press.dropFirst("handy-action:".count))) {
+      actionId = String(press.dropFirst("handy-action:".count))
+    } else { return false }
+    guard let response = response as? UNTextInputNotificationResponse,
+          let encoded = data["actions"] as? String,
+          let rows = try? JSONSerialization.jsonObject(with: Data(encoded.utf8)) as? [[String: Any]],
+          let row = rows.first(where: { $0["id"] as? String == actionId }),
+          let payload = row["payload"] as? [String: Any],
+          payload["type"] as? String == "http" || (payload["type"] as? String == "vd-agent" && payload["session"] is [String: Any]) else { return false }
+    let text = response.userText
+    let id = "\(data["submissionId"] as? String ?? response.notification.request.identifier)-\(actionId)"
+    let action: [String: Any] = ["id": actionId, "name": row["title"] as? String ?? "Action", "payload": payload]
+    var record: [String: Any] = ["id": id, "action": action, "text": text,
+      "presetId": data["presetId"] as? String ?? "",
+      "createdAt": ISO8601DateFormatter().string(from: Date()), "attempted": true,
+      "startedAt": Date().timeIntervalSince1970, "inFlight": true, "completed": false]
+    do {
+      gate.lock(); defer { gate.unlock() }
+      let url = try file(id)
+      let claim = url.deletingPathExtension().appendingPathExtension("claim")
+      if FileManager.default.fileExists(atPath: url.path) || FileManager.default.fileExists(atPath: claim.path) { completion(); return true }
+      try write(record, to: url) // Durable claim BEFORE any side-effecting request.
+      // Retain this small tombstone after JS acknowledges the journal. Duplicate
+      // OS callbacks must not resend an already imported success/uncertain write.
+      try Data().write(to: claim, options: [.atomic, .completeFileProtectionUntilFirstUserAuthentication])
+    } catch {
+      feedback(response, notification, actionId, text, id, "Draft could not be saved. Open the editor; no request was sent.", false, completion)
+      return true
+    }
+    Task {
+      var success = false
+      var message = "Delivery could not be confirmed. Review the destination before retrying in the editor."
+      if text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+        message = "Tap this notification to continue in the editor. No empty request was sent."
+      } else {
+        do { message = try await HandyBackgroundDelivery().deliver(payload, text); success = true }
+        catch Failure.retained(let safeMessage) { message = safeMessage }
+        catch { /* Never display errors/server bodies that could contain headers. */ }
+      }
+      record["inFlight"] = false; record["completed"] = success
+      do {
+        try finish(record, id)
+      } catch { success = false; message = "Delivery may have succeeded, but the receipt could not be saved. Review before retrying." }
+      feedback(response, notification, actionId, text, id, message, success, completion)
+    }
+    return true
+  }
+
+  private static func feedback(_ response: UNNotificationResponse, _ notification: [String: Any],
+    _ actionId: String, _ text: String, _ id: String, _ message: String, _ success: Bool,
+    _ completion: @escaping () -> Void) {
+    let center = UNUserNotificationCenter.current()
+    let content = UNMutableNotificationContent()
+    content.title = success ? "Sent" : "Continue in Handy Actions"
+    content.body = message
+    if success, let original = notification["data"] as? [String: Any], let url = original["workspaceBrowserUrl"] as? String {
+      content.userInfo = ["__notifee_notification": ["id": "handy-background-result-\(id)", "data": ["workspaceBrowserUrl": url]]]
+    }
+    if !success {
+      content.categoryIdentifier = "handy-action-editor-v1"
+      var updated = notification
+      var data = notification["data"] as? [String: Any] ?? [:]
+      // Failed/uncertain writes retain the editor recovery entry point and text.
+      data.removeValue(forKey: "workspaceBrowserUrl")
+      data["captureActionId"] = actionId; data["editorText"] = text; data["recoverySubmissionId"] = id
+      updated["data"] = data; updated["ios"] = ["categoryId": content.categoryIdentifier]
+      content.userInfo = ["__notifee_notification": updated]
+    }
+    let requestId = response.notification.request.identifier
+    if requestId.hasPrefix("handy-preset-") && success {
+      var next = notification
+      var nextData = notification["data"] as? [String: Any] ?? [:]
+      nextData["submissionId"] = UUID().uuidString; next["data"] = nextData
+      let panel = response.notification.request.content.mutableCopy() as! UNMutableNotificationContent
+      panel.userInfo = ["__notifee_notification": next]
+      center.add(UNNotificationRequest(identifier: requestId, content: panel, trigger: nil)) { _ in
+        center.add(UNNotificationRequest(identifier: "handy-background-result-\(id)", content: content, trigger: nil)) { _ in completion() }
+      }
+    } else {
+      center.add(UNNotificationRequest(identifier: requestId, content: content, trigger: nil)) { _ in completion() }
+    }
+  }
+
+  func profile(_ id: String) throws -> [String: Any] {
+    let key = Data("handy-origin-\(id)".utf8)
+    let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword,
+      kSecAttrService as String: "handy-actions-origins-v1:no-auth", kSecAttrAccount as String: key,
+      kSecAttrGeneric as String: key, kSecReturnData as String: true, kSecMatchLimit as String: kSecMatchLimitOne]
