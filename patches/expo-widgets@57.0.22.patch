+  }
+
+  @MainActor @available(iOS 17.0, *)
+  private static func postQuery(_ search: Search, message: String = "", text: String = "") async throws {
+    guard try read(search.id).revision == search.revision, try HandyActivityCoordinator.containsSearch(search.id) else { return }
+    let center = UNUserNotificationCenter.current()
+    let reply = UNTextInputNotificationAction(identifier: submit, title: "Search workspaces", options: [], textInputButtonTitle: "Search", textInputPlaceholder: "Workspace name…")
+    var categories = await center.notificationCategories()
+    guard try read(search.id).revision == search.revision, try HandyActivityCoordinator.containsSearch(search.id) else { return }
+    categories = Set(categories.filter { $0.identifier != category })
+    categories.insert(UNNotificationCategory(identifier: category, actions: [reply], intentIdentifiers: [], options: []))
+    center.setNotificationCategories(categories)
+    let row = try JSONSerialization.jsonObject(with: Data(search.action.utf8)) as? [String: Any] ?? [:]
+    let actions: [[String: Any]] = [["id": row["id"] ?? "search", "title": row["name"] ?? "Search workspaces", "payload": row["payload"] ?? [:]]]
+    let data = ["searchId": search.id, "revision": search.revision, "captureActionId": row["id"] as? String ?? "search", "presetId": search.presetId, "editorText": text,
+      "actions": String(decoding: try JSONSerialization.data(withJSONObject: actions), as: UTF8.self)]
+    let content = UNMutableNotificationContent()
+    content.title = "Search VD workspaces"
+    content.body = message.isEmpty ? "Expand and choose Search workspaces. Results appear in the search Live Activity." : message
+    content.categoryIdentifier = category
+    content.userInfo = ["__notifee_notification": ["id": "handy-workspace-search-query", "title": content.title, "body": content.body, "data": data, "ios": ["categoryId": category]]]
+    try await center.add(UNNotificationRequest(identifier: "handy-workspace-search-query", content: content, trigger: nil))
+  }
+}
