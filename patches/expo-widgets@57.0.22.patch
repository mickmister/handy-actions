+    }
+    guard let preview = try await request(session, connection, "\(path)/conversation-preview?limit=1") as? [String: Any],
+      preview["session_id"] as? String == id, let running = preview["has_running_turn"] as? Bool else { throw Failure.retained("Cannot verify session activity. Open the editor; draft retained.") }
+    let prefix = payload["prefix"] as? String ?? ""
+    let prompt = prefix.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? text : prefix + "\n" + text
+    let executorConfig = ["executor": executor]
+    if running {
+      guard let latest = try await request(session, connection, "\(path)/queue") as? [String: Any], latest["status"] as? String == "empty" else {
+        throw Failure.retained("Queue changed. Review it in the editor; no overwrite was attempted.")
+      }
+      let contents: [String: Any] = ["message": prompt, "executor_config": executorConfig]
+      let body = try JSONSerialization.data(withJSONObject: contents)
