+    if payload["type"] as? String == "http" {
+      guard let path = payload["path"] as? String, let method = payload["method"] as? String,
+            ["GET", "POST", "PUT", "PATCH", "DELETE"].contains(method), let format = payload["bodyFormat"] as? String,
+            ["none", "json", "text"].contains(format), let template = payload["body"] as? String else { throw Failure.retained("Invalid HTTP action; open the editor.") }
+      guard method != "GET" || format == "none" else { throw Failure.retained("GET actions cannot have a body.") }
+      var body: Data? = nil
+      if format == "json" {
+        func substitute(_ value: Any) -> Any {
+          if let string = value as? String { return string.replacingOccurrences(of: "{text}", with: text) }
+          if let array = value as? [Any] { return array.map(substitute) }
+          if let object = value as? [String: Any] { return object.mapValues(substitute) }
+          return value
+        }
+        body = try JSONSerialization.data(withJSONObject: substitute(JSONSerialization.jsonObject(with: Data(template.utf8), options: .fragmentsAllowed)), options: .fragmentsAllowed)
+      } else if format == "text" { body = Data(template.replacingOccurrences(of: "{text}", with: text).utf8) }
+      _ = try await request(session, connection, path.replacingOccurrences(of: "{text}", with: encode(text)), method, body,
