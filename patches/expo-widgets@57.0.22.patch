+  }
+  private static func target(_ search: Search, _ operation: String, _ extra: [String: Any] = [:]) throws -> String {
+    var value: [String: Any] = ["operation": operation, "searchId": search.id, "revision": search.revision]
+    extra.forEach { value[$0.key] = $0.value }
