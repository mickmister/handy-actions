+    guard current.revision == search.revision, currentActivity(search) != nil else { return }
+    let label = String((latest.name?.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty == false ? latest.name! : latest.created_at).prefix(80)) + " · " + executor
