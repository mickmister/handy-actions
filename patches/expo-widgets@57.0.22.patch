+      "retry_process_id": NSNull(), "force_when_dirty": NSNull(), "perform_git_reset": NSNull()]
+    let body = try JSONSerialization.data(withJSONObject: contents)
+    _ = try await request(session, connection, "\(path)/follow-up", "POST", body, "application/json")
+    return "Prompt sent to the locked session."
+  }
+}
diff --git a/ios/HandyNoteInbox.swift b/ios/HandyNoteInbox.swift
new file mode 100644
index 0000000000000000000000000000000000000000..b672a0c4cf60367976f03e0ca7bcde441371cfd6
--- /dev/null
+++ b/ios/HandyNoteInbox.swift
@@ -0,0 +1,39 @@
+import Foundation
+import CryptoKit
+
+// Written by the Notifee native response callback before notification completion.
+// Read/ack are separate so React storage failures never discard the native copy.
+enum HandyNoteInbox {
+  private static func directory() throws -> URL {
+    try FileManager.default.url(
+      for: .applicationSupportDirectory, in: .userDomainMask,
+      appropriateFor: nil, create: true
+    ).appendingPathComponent("HandyActionsNoteInbox", isDirectory: true)
+  }
+
+  static func read() throws -> [[String: Any]] {
+    let folder = try directory()
+    guard FileManager.default.fileExists(atPath: folder.path) else { return [] }
+    let files = try FileManager.default.contentsOfDirectory(
+      at: folder, includingPropertiesForKeys: nil
+    ).filter { $0.pathExtension == "json" }
+    return try files.map { file in
+      let data = try Data(contentsOf: file)
+      guard let note = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+        throw NSError(domain: "HandyNoteInbox", code: 1, userInfo: [
+          NSLocalizedDescriptionKey: "A captured note could not be read; its file was retained."
+        ])
+      }
+      return note
+    }.sorted { ($0["createdAt"] as? String ?? "") < ($1["createdAt"] as? String ?? "") }
+  }
+
+  static func acknowledge(id: String) throws {
+    // Must match CommonCrypto's SHA256 UTF-8 filename in the Notifee patch.
+    let digest = SHA256.hash(data: Data(id.utf8)).map { String(format: "%02x", $0) }.joined()
+    let file = try directory().appendingPathComponent("\(digest).json")
+    if FileManager.default.fileExists(atPath: file.path) {
+      try FileManager.default.removeItem(at: file)
+    }
+  }
+}
