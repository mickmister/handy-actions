+    let end = min(start + 3, search.workspaces.count)
+    var props: [String: Any] = ["searchId": search.id, "title": search.query.isEmpty ? "Search VD workspaces" : "\(start + (end > start ? 1 : 0))–\(end) of \(search.workspaces.count): \(String(search.query.prefix(32)))",
+      "message": String(message.prefix(120)), "results": try (start..<max(start, end)).map { index in
+        ["title": search.workspaces[index].title, "target": try target(search, "select", ["index": index])]
+      }, "searchAgain": try target(search, "again")]
